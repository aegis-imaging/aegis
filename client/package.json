{
  "name": "@aegis/client",
  "version": "0.2.0",
  "description": "DICOM anonymization and upload library for AEGIS (tag + pixel-level)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "dcmjs": "^0.50.1",
    "dicom-parser": "^1.8.21"
  },
  "peerDependencies": {
    "tesseract.js": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "tesseract.js": {
      "optional": true
    }
