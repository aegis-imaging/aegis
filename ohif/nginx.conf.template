server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/mime.types;

    gzip on;
    gzip_min_length 1000;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css application/json application/javascript
               application/x-javascript text/xml application/xml
               application/xml+rss text/javascript;

    # ── DICOMweb proxy ────────────────────────────────────────────────────────
    # OHIF JS makes same-origin requests to /dicomweb/ and /dicomweb-raw/.
    # nginx forwards them server-side to the real API backend (${API_URL}).
    # No CORS headers required — the browser never sees a cross-origin request.

    location /dicomweb/ {
        proxy_pass        ${API_URL}/dicomweb/;
        proxy_set_header  Host              $proxy_host;
        proxy_set_header  X-Real-IP         $remote_addr;
        proxy_set_header  X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header  X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout    120s;
        proxy_send_timeout    120s;
    }

    location /dicomweb-raw/ {
        proxy_pass        ${API_URL}/dicomweb-raw/;
        proxy_set_header  Host              $proxy_host;
        proxy_set_header  X-Real-IP         $remote_addr;
        proxy_set_header  X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header  X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout    120s;
        proxy_send_timeout    120s;
    }

    # ── Health check ──────────────────────────────────────────────────────────
    location = /health {
        default_type application/json;
        return 200 '{"status":"healthy"}';
    }

    # ── CSP: allow iframe embedding from the admin dashboard ─────────────────
    # Without frame-ancestors, browsers block cross-origin iframe embedding.
    add_header Content-Security-Policy "frame-ancestors https://admin.aegisimaging.ai https://aegisimaging.ai https://www.aegisimaging.ai http://localhost:3001 http://localhost:3000 'self'" always;

    # ── SPA fallback — all client-side routes serve index.html ───────────────
    location / {
        try_files $uri $uri/ /index.html;
    }
}
