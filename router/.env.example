# ── Identity ──────────────────────────────────────────────────────────────
# Issued by `aegis-router-init`; uniquely identifies this spoke to the cloud.
ROUTER_SITE_ID=site-CHANGEME
ROUTER_SITE_NAME=Example General Hospital

# ── DICOM SCP (incoming from local PACS) ──────────────────────────────────
DIMSE_AE_TITLE=AEGIS_ROUTER
DIMSE_PORT=11112
DIMSE_MAX_ASSOCIATIONS=10

# ── HTTP server (web upload + operator API) ───────────────────────────────
HTTP_PORT=8080

# ── On-disk locations ─────────────────────────────────────────────────────
# These live inside the named volume `router-data` by default. Override only
# if you want bind-mounts to host paths the IT team manages directly.
ROUTER_DATA_DIR=/var/lib/aegis-router
ROUTER_QUARANTINE_DIR=/var/lib/aegis-router/quarantine

# ── MIDI-B tag de-identification ──────────────────────────────────────────
# Salt is used to pseudonymize PatientID etc. Keep it stable per site so
# longitudinal studies link correctly. NEVER share across sites.
MIDI_B_SALT=CHANGE-ME-to-a-long-random-string
MIDI_B_DATE_SHIFT=true
MIDI_B_DATE_SHIFT_MAX_DAYS=365
MIDI_B_KEEP_PRIVATE_TAGS=false
# Comma-separated tag names to retain despite the profile (e.g. ProtocolName).
MIDI_B_RETAINED_TAGS=

# ── Optional sidecars (set to enable; matches `--profile X` in compose) ───
# Uncomment the URL for each capability you've enabled via compose profile.
# DEFACING_SERVICE_URL=http://defacing:8080
# PHI_DETECTION_SERVICE_URL=http://phi-detection:8080
# QC_SERVICE_URL=http://qc:8080
# CLASSIFICATION_SERVICE_URL=http://classification:8080
# PROTOCOL_SERVICE_URL=http://protocol:8080
# BIDS_SERVICE_URL=http://bids:8080
# ANALYTICS_SERVICE_URL=http://analytics:8080
# SCT_SERVICE_URL=http://sct:8080

# ── Cloud forwarding (mTLS) ───────────────────────────────────────────────
# When all three are set, the router auto-forwards de-identified studies.
# When any are missing, studies stay local for human pickup.
CLOUD_RECEIVER_URL=https://aegisimaging.ai
CLOUD_PROJECT_SLUG=default
CLOUD_INSTITUTION_SLUG=
CLOUD_CLIENT_CERT=/certs/client.crt
CLOUD_CLIENT_KEY=/certs/client.key
# Empty == use the system trust store (the right choice for a real public CA).
CLOUD_CA_CERT=

# ── Retry / quarantine ────────────────────────────────────────────────────
SHIP_RETRY_INITIAL_SECONDS=15
SHIP_RETRY_MAX_SECONDS=600
SHIP_RETRY_MAX_ATTEMPTS=8
# Optional webhook the cloud control plane subscribes to for quarantine alerts.
QUARANTINE_ALERT_URL=

# ── Operator API ──────────────────────────────────────────────────────────
# When empty, the operator endpoints (/quarantine, /audit) are unauthenticated.
# That's fine on a closed LAN but set a key for anything internet-exposed.
OPERATOR_API_KEY=
