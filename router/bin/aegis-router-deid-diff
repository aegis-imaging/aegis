#!/usr/bin/env python3
"""Tag-by-tag comparison between a raw DICOM directory and its de-identified
counterpart. Useful for validating de-id accuracy — what was changed, what was
removed, what was retained.

Designed for the "writing a paper" use case: given a study you sent through
the router, this prints a table you can include in an evaluation section.

Examples
--------
  # Compare what the router did to a study you sent it
  ./bin/aegis-router-deid-diff \
      --raw  /var/lib/aegis-router/studies/<study_uid>/raw \
      --deid /var/lib/aegis-router/studies/<study_uid>/deid

  # CSV output for downstream stats / plots
  ./bin/aegis-router-deid-diff --raw ... --deid ... --csv > deid_diff.csv

Notes
-----
Compares only the first instance per directory by default (DICOM tag-level
de-id is per-instance and largely homogeneous within a study). Pass --all to
compare every file pair (slow on large studies).
"""

from __future__ import annotations

import argparse
import csv
import sys
from pathlib import Path

try:
    import pydicom
    from pydicom.tag import Tag
except ImportError:
    print("missing dependency: pip install pydicom", file=sys.stderr)
    sys.exit(2)


CHANGE_KIND_LABELS = {
    "removed": "removed (tag dropped)",
    "blanked": "blanked (kept tag, empty value)",
    "modified": "modified (value changed)",
    "retained": "retained (unchanged)",
    "added": "added (only in deid)",
}


def list_dicoms(d: Path) -> list[Path]:
    return sorted(d.glob("*.dcm"))


def compare_instances(raw_ds: "pydicom.Dataset", deid_ds: "pydicom.Dataset") -> list[dict]:
    rows: list[dict] = []
    raw_tags = {elem.tag for elem in raw_ds.iterall()}
    deid_tags = {elem.tag for elem in deid_ds.iterall()}

    for tag in sorted(raw_tags | deid_tags):
        raw_elem = raw_ds.get(tag, None)
        deid_elem = deid_ds.get(tag, None)
        raw_val = _value(raw_elem)
        deid_val = _value(deid_elem)
        if raw_elem is not None and deid_elem is None:
            kind = "removed"
        elif raw_elem is None and deid_elem is not None:
            kind = "added"
        elif raw_val == deid_val:
            kind = "retained"
        elif deid_val == "":
            kind = "blanked"
        else:
            kind = "modified"
        rows.append(
            {
                "tag": str(tag),
                "keyword": (deid_elem or raw_elem).keyword if (deid_elem or raw_elem) is not None else "",
                "vr": (deid_elem or raw_elem).VR if (deid_elem or raw_elem) is not None else "",
                "change": kind,
                "raw": _short(raw_val),
                "deid": _short(deid_val),
            }
        )
    return rows


def _value(elem) -> str:
    if elem is None:
        return "<absent>"
    try:
        return str(elem.value)
    except Exception:
        return "<unreadable>"


def _short(s: str, limit: int = 80) -> str:
    s = s.replace("\n", "\\n")
    return s if len(s) <= limit else s[: limit - 1] + "…"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--raw", type=Path, required=True, help="Directory of original DICOM files")
    parser.add_argument("--deid", type=Path, required=True, help="Directory of de-identified DICOM files")
    parser.add_argument("--all", action="store_true", help="Compare every file pair, not just the first")
    parser.add_argument("--csv", action="store_true", help="Output CSV instead of a human-readable table")
    parser.add_argument("--changes-only", action="store_true", help="Skip retained rows in the human output")
    args = parser.parse_args()

    raw_files = list_dicoms(args.raw)
    deid_files = list_dicoms(args.deid)
    if not raw_files or not deid_files:
        print(f"no DICOM files found (raw={len(raw_files)} deid={len(deid_files)})", file=sys.stderr)
        return 2

    pairs = list(zip(raw_files, deid_files))
    if not args.all:
        pairs = pairs[:1]

    all_rows: list[dict] = []
    for r_path, d_path in pairs:
        raw_ds = pydicom.dcmread(str(r_path), stop_before_pixels=True)
        deid_ds = pydicom.dcmread(str(d_path), stop_before_pixels=True)
        all_rows.extend(compare_instances(raw_ds, deid_ds))

    if args.csv:
        w = csv.DictWriter(sys.stdout, fieldnames=["tag", "keyword", "vr", "change", "raw", "deid"])
        w.writeheader()
        w.writerows(all_rows)
        return 0

    summary: dict[str, int] = {}
    for r in all_rows:
        summary[r["change"]] = summary.get(r["change"], 0) + 1
    print()
    print(f"raw  = {args.raw}  ({len(raw_files)} files)")
    print(f"deid = {args.deid}  ({len(deid_files)} files)")
    print(f"files compared: {len(pairs)}")
    print(f"summary: {dict(sorted(summary.items()))}")
    print()
    if args.changes_only:
        all_rows = [r for r in all_rows if r["change"] != "retained"]
    print(f"{'TAG':<14} {'KEYWORD':<32} {'VR':<3} {'CHANGE':<9} RAW → DEID")
    print("-" * 110)
    for r in all_rows:
        print(
            f"{r['tag']:<14} {r['keyword']:<32} {r['vr']:<3} "
            f"{r['change']:<9} {_short(r['raw'], 40)} → {_short(r['deid'], 40)}"
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
