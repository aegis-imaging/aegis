# Vercel serverless function — Brevo SMTP for contact form delivery.
# Set these in Vercel Dashboard → Project → Settings → Environment Variables.
# Without them the contact form logs submissions to the console but does NOT email them.

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login@example.com
BREVO_SMTP_PASS=your-brevo-smtp-password
BREVO_SMTP_FROM=AEGIS <noreply@aegisimaging.ai>
