# Export portal — set only when deploying to a DIFFERENT origin than the API.
#
# Same-origin (default): export portal served from same domain as the API,
# or behind a proxy that routes /api → API backend.
# → No env vars needed; relative /api paths work automatically.
#
# Cross-origin (e.g. Vercel at https://export.aegisimaging.ai):
# → Set VITE_API_URL here so fetch calls reach the correct API host.
# → Also set EXPORT_PORTAL_BASE_URL on the Go API so share email links
#   point to this portal URL instead of the raw API endpoint.
VITE_API_URL=https://api.aegisimaging.ai
