project_id   = "aegis-prod"
region       = "us-central1"
environment  = "dev"
api_domain   = "api-dev.aegisimaging.ai"
admin_domain = "admin-dev.aegisimaging.ai"

# IAP OAuth credentials for the admin dashboard backend.
iap_oauth_client_id     = "YOUR_IAP_OAUTH_CLIENT_ID"
iap_oauth_client_secret = "YOUR_IAP_OAUTH_CLIENT_SECRET"

# Grant IAP web access to these identities.
iap_access_members = [
  "user:you@example.com",
]

# Seeds the first admin user in the DB on initial API startup (idempotent).
# Use the same account as iap_access_members so the user can log in immediately.
first_admin_email = "you@example.com"

# Public base URL of the export portal UI.
# When set, share email links point to the portal (?token=...) instead of the raw API endpoint.
# export_portal_base_url = "https://export.aegisimaging.ai"

# Container images (build + push these before terraform apply).
api_image                    = "us-central1-docker.pkg.dev/aegis-prod/aegis-services/api:latest"
admin_dashboard_image        = "us-central1-docker.pkg.dev/aegis-prod/aegis-services/admin-dashboard:latest"
defacing_image               = "us-central1-docker.pkg.dev/aegis-prod/aegis-services/defacing:latest"
phi_detection_image          = "us-central1-docker.pkg.dev/aegis-prod/aegis-services/phi-detection:latest"
qc_service_image             = "us-central1-docker.pkg.dev/aegis-prod/aegis-services/qc-service:latest"
bids_service_image           = "us-central1-docker.pkg.dev/aegis-prod/aegis-services/bids-service:latest"
classification_service_image = "us-central1-docker.pkg.dev/aegis-prod/aegis-services/classification-service:latest"
protocol_service_image       = "us-central1-docker.pkg.dev/aegis-prod/aegis-services/protocol-service:latest"
ohif_image                   = "us-central1-docker.pkg.dev/aegis-prod/aegis-services/ohif:latest"
weasis_image                 = "us-central1-docker.pkg.dev/aegis-prod/aegis-services/weasis:latest"
mcp_server_image             = "us-central1-docker.pkg.dev/aegis-prod/aegis-services/mcp-server:latest"
# mcp_server_aegis_api_token = ""  # populate via: gcloud secrets versions add <prefix>-mcp-aegis-api-token --data-file=-

# Cloud SQL runtime DB password handling.
# Preferred: generated password persisted to Secret Manager.
generate_db_password        = true
generated_db_password_length = 32
db_password_secret_id       = "aegis-dev-db-password"

# Optional explicit password override (if you must control the value externally).
# db_password = "set-via-secure-secret-source"

# SMTP relay config (documented PSC-equivalent path via Cloud NAT static egress IP).
smtp_relay_host = "smtp-relay.example.org"
smtp_relay_port = 587
smtp_from       = "noreply@aegisimaging.ai"

# Recipient for contact form submissions from the landing page.
# Defaults to contact@aegisimaging.ai — override here to route to a different inbox.
contact_email = "contact@aegisimaging.ai"

# Sidecar warmup: set sidecar_min_instances=1 to keep all processing services
# always-warm (eliminates ~14s cold-start on first use, costs ~$38/month per sidecar).
# Leave at 0 (default) for cost-efficient scale-to-zero behaviour.
# sidecar_min_instances = 1

# Optional: alert destination and Cloud Armor ingress controls.
alert_email                    = "ops@example.com"
cloud_armor_allowed_ip_ranges  = ["*"]
deletion_protection            = true
enable_admin_iap               = true
enable_monitoring_alerts       = true

# DIMSE receiver — Compute Engine VM for DICOM C-STORE SCP (TCP 11112).
# Leave dimse_receiver_image empty to skip all DIMSE resources (default).
# Set to the full Artifact Registry URI once you've built and pushed the image:
#   dimse_receiver_image = "us-central1-docker.pkg.dev/<project>/aegis-services/dimse-receiver:latest"
# dimse_receiver_image       = ""
# dimse_receiver_machine_type = "e2-small"
# dimse_receiver_zone         = ""   # defaults to <region>-a
# dimse_api_url               = "https://api.aegisimaging.ai"
# dimse_project_slug          = "default"
# dimse_source_ranges         = ["0.0.0.0/0"]   # restrict to PACS IPs in production
