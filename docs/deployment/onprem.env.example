# AEGIS on-prem .env example — copy to /srv/aegis/.env and customise.
#
# Generate the two secret values with:
#     openssl rand -hex 24
#
# Lock the file down once you're done:
#     sudo chmod 600 /srv/aegis/.env
#     sudo chown root:root /srv/aegis/.env

# ── Secrets ────────────────────────────────────────────────────────────────
# The installer script substitutes the __GENERATE_*__ placeholders with
# `openssl rand -hex 24` output. If you're filling this out by hand,
# replace each placeholder with a separate random hex string.
DB_PASSWORD=__GENERATE_DB_PASSWORD__
DIMSE_OPERATOR_API_KEY=__GENERATE_DIMSE_KEY__

# ── Public-facing URL (used in emails, share links, etc.) ──────────────────
PUBLIC_BASE_URL=https://aegis.your-institution.local

# ── Auth ───────────────────────────────────────────────────────────────────
# For initial setup only, set AUTH_ENABLED=false so you can log in without
# wiring up SSO. Flip to true before sharing with anyone else.
AUTH_ENABLED=false
AUTH_PROVIDER=auto
DEV_USER_EMAIL=admin@your-institution.local

# ── Storage ────────────────────────────────────────────────────────────────
STORAGE_MODE=local
LOCAL_STORAGE_DIR=/app/data
DIMSE_DATA_DIR=/app/data

# ── DIMSE listener ─────────────────────────────────────────────────────────
DIMSE_AE_TITLE=AEGIS
DIMSE_PORT=11112
DIMSE_PROJECT_SLUG=default

# ── Pipeline (auto-dispatch is on by default) ──────────────────────────────
PIPELINE_AUTO=true

# ── Email (optional — leave SMTP_HOST empty to disable email entirely) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=AEGIS <noreply@your-institution.local>
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Time zone (display only — internal storage stays UTC) ──────────────────
APP_TIMEZONE=UTC
