# Required — AEGIS API connection
AEGIS_API_BASE_URL=http://localhost:8080
AEGIS_API_TOKEN=your-service-token-here

# MCP mode: readonly (default) or operator
# readonly  — all write tools are blocked
# operator  — write tools allowed when MCP_ENABLE_WRITE_TOOLS=true
MCP_MODE=readonly

# Write tools are disabled by default.
# Set to true only after reviewing the threat model and confirming
# operator-level access is appropriate for this MCP client.
MCP_ENABLE_WRITE_TOOLS=false

# Rate limits (per-minute sliding window; 0 = unlimited)
MCP_READ_RATE_LIMIT_PER_MINUTE=240
MCP_WRITE_RATE_LIMIT_PER_MINUTE=60

# Idempotency cache TTL for write tools (seconds)
MCP_WRITE_IDEMPOTENCY_TTL_SECONDS=900

# Optional: identifies the calling process in audit logs
# MCP_CALLER_ID=claude-desktop
